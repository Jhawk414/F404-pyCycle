direction: right

inlet: "Inlet"
fan: "Fan\n10,000 rpm"
splitter: "Splitter"
bypass_duct: "Bypass Duct"
hpc: "HPC\n14,000 rpm"
bld3: "Bleed 3"
burner: "Combustor\nTt4: 3100 °R (MIL)"
hpt: "HPT"
lpt: "LPT"
mixer: "Mixer"
afterburner: "Afterburner\nTt7: 3800 °R (Max AB)"
nozzle: "Nozzle\nNet Thrust (Fn)"

inlet -> fan -> splitter

# Bypass defined FIRST:
splitter -> bypass_duct -> mixer: {
  style: { stroke: "#2563EB"; stroke-width: 2 }
}

# Core defined SECOND:
splitter -> hpc -> bld3 -> burner -> hpt -> lpt -> mixer -> afterburner -> nozzle: {
  style: { stroke: "#1E293B"; stroke-width: 2 }
}

# Shafts:
hpc <-> hpt: "HP Shaft (14,000 rpm)" {
  style: { stroke: "#D97706"; stroke-width: 2; stroke-dash: 2 }
}
fan <-> lpt: "LP Shaft (10,000 rpm)" {
  style: { stroke: "#D97706"; stroke-width: 2; stroke-dash: 2 }
}
